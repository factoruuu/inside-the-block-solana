# Copy to .env (docker compose reads it automatically). Never commit .env.
RPC_URL=https://api.mainnet-beta.solana.com
# Optional separate endpoint used only for sendTransaction:
SEND_RPC_URL=
# Required for `run --live` and `fund-devnet`: mainnet-beta | devnet | testnet
CLUSTER=
# Hard fee budget for the whole campaign. Default = the brief's ~0.05 SOL.
SPEND_CAP_LAMPORTS=50000000
